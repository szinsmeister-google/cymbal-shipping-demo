# =============================================================================
# Cymbal Shipping Demo-as-Code Environment Configuration
# Copy this file to `.env` and fill in your GCP, Looker, and Gemini agent IDs.
# Never commit `.env` or credential files to git.
# =============================================================================

# --- Google Cloud Project ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=123456789012

# --- BigQuery & Lakehouse ---
# Co-locate BigQuery, Spanner, GCS, and Knowledge Catalog in the same region
# so Spanner external dataset federation and object tables work in place.
BQ_DATASET=cymbal_shipping
BQ_LOCATION=us-east1
BQ_LAKE_CONNECTION=cymbal_shipping_lake
GCS_EVIDENCE_BUCKET=cymbal-shipping-field-evidence-your-project-number

# --- Cloud Spanner (Operational Live Tracking) ---
SPANNER_INSTANCE=cymbal-shipping-ops
SPANNER_DATABASE=cymbal_shipping_ops
SPANNER_CONFIG=regional-us-east1

# --- Knowledge Catalog & Enrichment Agent ---
KC_LOCATION=us-east1
GCS_ENRICHMENT_BUCKET=cymbal-shipping-enrichment-your-project-number
KC_ENRICHMENT_TASK_ID=cymbal-shipping-enrichment
KC_ENRICHMENT_CR_ID=your-change-request-uuid
KC_ENRICHMENT_SA=knowledge-catalog-enrichment@your-gcp-project-id.iam.gserviceaccount.com

# --- Looker (Semantic Model, Native Dashboard, Data App) ---
LOOKER_BASE_URL=https://your-looker-instance.cloud.looker.com
LOOKER_INSTANCE_ID=your-looker-instance-id
LOOKER_CLIENT_ID=your-looker-api-client-id
LOOKER_CLIENT_SECRET=your-looker-api-client-secret
LOOKER_DB_CONNECTION=default_bigquery_connection
LOOKER_DATA_APP_DASHBOARD_ID=your-data-app-dashboard-id

# --- Gemini Agent (Discovery Engine / Agent Designer) ---
GEMINI_ENGINE_ID=your-gemini-engine-id
GEMINI_AGENT_ID=your-gemini-agent-id
GEMINI_APP_CID=your-gemini-app-cid

# --- Gemini Agent Data Connectors (tag-resolved bindings) ---
LOOKER_DATA_STORE_ID=your-looker-datastore-id
LOOKER_CONNECTOR_COLLECTION=your-looker-connector-collection
LOOKER_CONNECTOR_TAG=your-looker-connector-tag

BQ_DATA_STORE_ID=your-bq-datastore-id
BQ_CONNECTOR_COLLECTION=your-bq-connector-collection
BQ_CONNECTOR_TAG=your-bq-connector-tag

SPANNER_DATA_STORE_ID=your-spanner-datastore-id
SPANNER_CONNECTOR_COLLECTION=your-spanner-connector-collection
SPANNER_CONNECTOR_TAG=your-spanner-connector-tag

# --- Local CLI ---
GCLOUD_BIN=gcloud
